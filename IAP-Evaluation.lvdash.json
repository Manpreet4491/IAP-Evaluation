{
  "datasets": [
    {
      "name": "fact_sales",
      "displayName": "Fact Sales Metrics",
      "config": {
        "source": "dev.gold.fact_sales",
        "measures": [
          {
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "synonyms": [
              "revenue",
              "sales"
            ],
            "name": "total_net_revenue",
            "expr": "SUM(extendedprice * (1 - discount))",
            "comment": "Sum of extended price times (1 - discount)"
          },
          {
            "name": "order_count",
            "expr": "COUNT(DISTINCT orderkey)",
            "displayName": "Distinct Orders",
            "comment": "Count of distinct orders"
          },
          {
            "name": "active_customer_count",
            "expr": "COUNT(DISTINCT customerkey)",
            "displayName": "Active Customers",
            "comment": "Count of distinct customers"
          },
          {
            "displayName": "Avg Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_order_value",
            "expr": "MEASURE(`total_net_revenue`) / MEASURE(`order_count`)",
            "comment": "Net revenue divided by distinct orders"
          },
          {
            "displayName": "Average Discount",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_discount",
            "expr": "AVG(discount)",
            "comment": "Average discount rate"
          },
          {
            "name": "total_quantity",
            "expr": "SUM(quantity)",
            "displayName": "Total Quantity",
            "comment": "Total quantity ordered"
          },
          {
            "displayName": "Avg Shipping Days",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "avg_ship_days",
            "expr": "AVG(DATEDIFF(l_receiptdate, l_shipdate))",
            "comment": "Average days from ship to receipt"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "expr": "orderdate",
            "comment": "Order date"
          },
          {
            "expr": "customer_name",
            "comment": "Customer name"
          },
          {
            "expr": "product_name",
            "comment": "Product name"
          },
          {
            "expr": "supplier_name",
            "comment": "Supplier name"
          },
          {
            "expr": "nation_name",
            "comment": "Customer nation"
          },
          {
            "expr": "region_name",
            "comment": "Customer region"
          },
          {
            "name": "market_segment",
            "expr": "dim_customer.market_segment",
            "comment": "Customer market segment"
          },
          {
            "name": "shipping_mode",
            "expr": "l_linestatus",
            "comment": "Shipping mode (line status)"
          },
          {
            "expr": "l_returnflag",
            "comment": "Return flag"
          },
          {
            "expr": "o_orderpriority",
            "comment": "Order priority"
          },
          {
            "expr": "o_orderstatus",
            "comment": "Order status"
          }
        ],
        "joins": [
          {
            "name": "dim_customer",
            "source": "dev.gold.dim_customer",
            "on": "source.customerkey = dim_customer.customerkey"
          }
        ]
      }
    }
  ],
